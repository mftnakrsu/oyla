{
  "name": "oyla-video",
  "version": "1.0.0",
  "description": "Oyla demo video and README teaser, made with Remotion",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/fonts": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "render:demo": "remotion render OylaDemo out/oyla-demo.mp4 --codec=h264 --crf=22",
    "render:teaser": "remotion render OylaTeaser out/oyla-teaser.gif --codec=gif --every-nth-frame=2 --scale=0.5",
    "render:poster": "remotion still OylaDemo out/oyla-demo-poster.png --frame=690",
    "render": "npm run render:demo && npm run render:teaser && npm run render:poster",
    "build": "remotion bundle",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
